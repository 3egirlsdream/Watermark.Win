@using Microsoft.AspNetCore.Components.Web
@using Watermark.Razor.Workspace
@using Watermark.Razor.Components
@using Watermark.Razor.Components.Mac
@using Watermark.Shared.Models
@namespace Watermark.Razor.Workspace.Components
@inject IClientInstance ClientInstance
@inject WMTemplateStore TemplateStore
@inject WMWorkspaceController WorkspaceController
@inject WMTemplateLibraryService TemplateLibrary
@inject WMTemplateDesignerSession DesignerSession
@inject IWMPosterAssetLibrary PosterAssets
@inject IWMEditorInteractionProfileProvider InteractionProfiles
@inject IPopupService Popup
@implements IAsyncDisposable

<div class="@DesignerClass" tabindex="0" @onkeydown="HandleKeyDown">
    @if (editor is null)
    {
        <div class="designer-loading-state" role="status">
            @if (string.IsNullOrWhiteSpace(loadError))
            {
                <span class="designer-loading-spinner" aria-hidden="true"></span>
                <span>正在打开模板</span>
            }
            else
            {
                <WmIcon Color="error" Icon="warning-circle" />
                <span>@loadError</span>
                <MButton Text Class="secondary-command" OnClick="async () => await OnClose.InvokeAsync()">返回</MButton>
            }
        </div>
    }
    else
    {
        <MacDesignerToolbar TemplateName="@editor.Draft.Name"
                            IsDirty="@editor.IsDirty"
                            CanUndo="@(editor.CanUndo && !editor.IsTransactionActive)"
                            CanRedo="@(editor.CanRedo && !editor.IsTransactionActive)"
                            IsSaving="@isSaving"
                            SaveLabel="@(InstanceMode ? "完成" : "保存")"
                            Zoom="@zoom"
                            Exit="ToolbarExitAsync"
                            Save="SaveAsync"
                            Undo="UndoAsync"
                            Redo="RedoAsync"
                            Fit="FitAsync"
                            ZoomChanged="SetZoomAsync" />

        <div class="designer-workspace">
            <aside id="template-mobile-panel-Layers"
                   class="designer-layer-region @(presentation.Panel == WMPosterMobilePanel.Layers ? "mobile-panel-visible" : null)">
                <WMTemplateLayerPanel Editor="@editor"
                                      RenderResult="@renderResult"
                                      CloseRequested="CloseMobilePanelAsync" />
            </aside>
            <div class="designer-canvas-region">
                @if (isRendering && !IsAssetCropOpen)
                {
                    <div class="canvas-render-indicator" aria-label="正在更新预览"></div>
                }
                <div class="designer-template-canvas" hidden="@IsAssetCropOpen">
                    <WMTemplateCanvas @ref="canvasEditor"
                                      Editor="@editor"
                                      RenderResult="@renderResult"
                                      PreviewUrl="@previewUrl"
                                      Scene="@scenePresentation"
                                      Zoom="@zoom"
                                      AutoFitOnViewportResize="@Global.IsMobile"
                                      ZoomChanged="SetZoomAsync"
                                      SaveRequested="SaveAsync" />
                </div>
                @if (IsAssetCropOpen && selectedPosterAsset is not null && assetSelection is not null)
                {
                    <WMCropCanvas @key="selectedPosterAsset.Id"
                                  Class="poster-asset-crop-canvas"
                                  ImageUrl="@selectedPosterAsset.PreviewUrl"
                                  SourceWidth="@selectedPosterAsset.PixelWidth"
                                  SourceHeight="@selectedPosterAsset.PixelHeight"
                                  Settings="@assetSelection.CropSettings"
                                  SettingsChanged="PreviewAssetCropAsync"
                                  ApplyRequested="ConfirmAssetSelectionAsync"
                                  CancelRequested="ReturnToAssetLibrary" />
                }
            </div>
            <aside id="template-mobile-panel-Properties"
                   class="designer-inspector-region @(presentation.Panel == WMPosterMobilePanel.Properties ? "mobile-panel-visible" : null)">
                <div class="mobile-panel-body">
                    <WMTemplatePropertyPanel Editor="@editor"
                                             RenderResult="@renderResult"
                                             DesignFunc="@designFunc"
                                             Section="@presentation.InspectorSection"
                                             TextContentEditRequested="OpenMobileTextContentFromInspector"
                                             AssetEditRequested="OpenAssetLibraryFromInspectorAsync"
                                             CloseRequested="CloseMobilePanelAsync" />
                </div>
            </aside>
            <section id="template-mobile-panel-Add"
                     class="designer-add-region @(presentation.Panel == WMPosterMobilePanel.Add ? "mobile-panel-visible" : null)"
                     aria-label="添加模板对象">
                <WMTemplateAddPanel AddRequested="AddControlFromPanel"
                                    CloseRequested="CloseMobilePanelAsync" />
            </section>
            <section id="template-mobile-panel-TextContent"
                     class="designer-text-content-region @(presentation.Panel == WMPosterMobilePanel.TextContent ? "mobile-panel-visible" : null)"
                     aria-label="编辑文字内容">
                @if (mobileTextContentTarget is not null)
                {
                    <div class="mobile-panel-body">
                        <ExifConfig @ref="mobileTextContentEditor"
                                    mText="@mobileTextContentTarget"
                                    EmbeddedMobilePanel="@Global.IsMobile"
                                    MultipleAssetSources="@(ContainerNames.Count > 1)"
                                    ContainerId2Name="@ContainerNames"
                                    FieldLibraryVisibilityChanged="HandleFieldLibraryVisibilityChanged"
                                    OnClose="CompleteMobileTextContent"
                                    OnCancel="CancelMobileTextContent" />
                    </div>
                }
            </section>
            <section id="template-mobile-panel-AssetLibrary"
                     class="designer-asset-region @(presentation.Panel is WMPosterMobilePanel.AssetLibrary or WMPosterMobilePanel.AssetCrop ? "mobile-panel-visible" : null)"
                     aria-label="素材替换">
                @if (assetSelection is not null)
                {
                    <div class="asset-step"
                         hidden="@(presentation.Panel != WMPosterMobilePanel.AssetLibrary)">
                        <WMPosterAssetDrawer @key="assetSelection.TargetControlId"
                                             TemplateId="@CanvasId"
                                             TargetLabel="@AssetTargetLabel"
                                             InitialSelectedAssetId="@(selectedPosterAsset?.Id ?? string.Empty)"
                                             PreviewRequested="PreviewAssetAsync"
                                             ConfirmRequested="OpenAssetCropAsync"
                                             CancelRequested="CancelAssetSelectionAsync" />
                    </div>
                    <div class="asset-step"
                         hidden="@(presentation.Panel != WMPosterMobilePanel.AssetCrop)">
                        <WMPosterAssetCropPanel @key="assetSelection.TargetControlId"
                                                TargetLabel="@AssetTargetLabel"
                                                Fit="@assetSelection.Fit"
                                                FitChanged="PreviewAssetFitAsync"
                                                CropSettings="@assetSelection.CropSettings"
                                                SourceWidth="@(selectedPosterAsset?.PixelWidth ?? 0)"
                                                SourceHeight="@(selectedPosterAsset?.PixelHeight ?? 0)"
                                                CropSettingsChanged="PreviewAssetCropAsync"
                                                BackRequested="ReturnToAssetLibrary"
                                                AssetToolRequested="HandleAssetEditToolAsync"
                                                IsLogo="@(AssetTargetLogo is not null)"
                                                WhiteToTransparent="@(AssetTargetLogo?.White2Transparent == true)"
                                                AspectRatioLocked="@(AssetTargetLogo is not null && editor.IsLogoAspectRatioLocked(AssetTargetLogo.ID))"
                                                CompleteRequested="ConfirmAssetSelectionAsync" />
                    </div>
                }
            </section>
        </div>

        <WMPosterMobileToolRail Items="@MobileToolRailItems"
                                ActiveToolId="@presentation.ActiveToolId"
                                ToolSelected="ActivateMobileToolByIdAsync"
                                AriaLabel="模板配置" />
    }

    @if (editor is not null)
    {
        <MDialog Persistent @bind-Value="showExitDialog" ContentStyle="width:min(420px,calc(100vw - 48px));">
            <section class="exit-dialog" role="dialog" aria-modal="true" aria-labelledby="exit-dialog-title" aria-describedby="exit-dialog-description">
                <div class="exit-dialog-copy">
                    <h2 id="exit-dialog-title">保存模板更改？</h2>
                    <p id="exit-dialog-description">退出前可保存当前修改，或放弃本次编辑。</p>
                </div>
                <div class="exit-dialog-actions">
                    <MButton Color="primary" Small Elevation="0" Class="primary-command" Disabled="@isSaving" OnClick="SaveAndExitAsync">保存并退出</MButton>
                    <MButton Text Small Class="danger-command" Disabled="@isSaving" OnClick="DiscardAndExitAsync">放弃更改</MButton>
                    <MButton Text Small Class="secondary-command" Disabled="@isSaving" OnClick="ContinueEditing">继续编辑</MButton>
                </div>
            </section>
        </MDialog>
    }
</div>

@code {
#nullable enable
    [Parameter] public string CanvasId { get; set; } = string.Empty;
    [Parameter] public bool InstanceMode { get; set; }
    [Parameter] public string? InstanceCanvasJson { get; set; }
    [Parameter] public string? InitialMobileToolId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback<WMCanvas> OnInstanceCompleted { get; set; }

    private WMTemplateEditorState? editor;
    private WMTemplateCanvas? canvasEditor;
    private ExifConfig? mobileTextContentEditor;
    private WMText? mobileTextContentTarget;
    private WMPosterAssetSelectionSession? assetSelection;
    private WMPosterAssetReference? selectedPosterAsset;
    private WMDesignFunc? designFunc;
    private WMDesignRenderResult? renderResult;
    private WMDesignScenePresentation? scenePresentation;
    private string previewUrl = string.Empty;
    private CancellationTokenSource? draftDebounce;
    private readonly object draftTaskGate = new();
    private readonly HashSet<Task> draftTasks = [];
    private string loadError = string.Empty;
    private string renderError = string.Empty;
    private string saveNotice = string.Empty;
    private string loadedCanvasId = string.Empty;
    private string? loadedInstanceCanvasJson;
    private string? appliedInitialMobileToolId;
    private string requestedSnapshot = string.Empty;
    private string originalCanvasJson = string.Empty;
    private long renderVersion;
    private bool showExitDialog;
    private bool isSaving;
    private bool isRendering;
    private bool disposed;
    private bool compatibilityToastShown;
    private bool sceneFallbackToastShown;
    private string observedSelectionId = string.Empty;
    private double zoom = 1;
    private readonly WMPosterEditorPresentationState presentation = new();

    private string DesignerClass =>
        $"wm-template-designer {presentation.SpaceCssClass}"
        + (presentation.HasOpenPanel ? " mobile-panel-open" : " mobile-panel-none")
        + (presentation.Panel == WMPosterMobilePanel.Properties ? " mobile-properties-panel" : string.Empty)
        + (mobileTextContentTarget is not null ? " desktop-text-content-open" : string.Empty)
        + (assetSelection is not null ? " desktop-asset-open" : string.Empty)
        + (IsAssetCropOpen ? " asset-crop-preview-open" : string.Empty)
        + (presentation.IsTextFieldLibraryOpen ? " mobile-field-library-open" : string.Empty);

    private bool IsAssetCropOpen =>
        presentation.Panel == WMPosterMobilePanel.AssetCrop;

    private IWMControl? SelectedControl => editor is null
        || string.IsNullOrWhiteSpace(editor.SelectedControlId)
            ? null
            : WMControlTree.Find(editor.Draft, editor.SelectedControlId);

    private IReadOnlyList<WMPosterContextToolSpec> MobileTools =>
        WMPosterEditorPresentationState.ToolsFor(SelectedControl);

    private IReadOnlyList<WMMobileToolRailItem> MobileToolRailItems =>
        MobileTools.Select(tool => new WMMobileToolRailItem(
            tool.Id,
            tool.Label,
            tool.Icon,
            $"template-mobile-panel-{tool.Panel}"))
        .ToArray();

    private IWMControl? AssetTargetControl => assetSelection is null || editor is null
        ? null
        : WMControlTree.Find(editor.Draft, assetSelection.TargetControlId);

    private WMLogo? AssetTargetLogo => AssetTargetControl as WMLogo;

    private string AssetTargetLabel => assetSelection is null || editor is null
        ? "图片"
        : AssetTargetControl is { } target
            ? ControlName(target)
            : "图片";

    private Dictionary<string, string> ContainerNames
    {
        get
        {
            if (editor is null) return [];
            var names = Global.EnumerateControls(editor.Draft)
                .Where(control => WMPosterAssetSlots.Find(editor.Draft, control)?.Purpose == WMPosterAssetPurpose.Photo)
                .GroupBy(control => control.ID)
                .ToDictionary(group => group.Key, group => ControlName(group.First()));
            if (editor.Draft.HasPrimaryImage)
                names[editor.Draft.ID] = editor.Draft.Name;
            return names;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (editor is not null
            && string.Equals(loadedCanvasId, CanvasId, StringComparison.Ordinal)
            && string.Equals(loadedInstanceCanvasJson, InstanceCanvasJson, StringComparison.Ordinal))
            return;

        await LoadEditorAsync();
    }

    private async Task LoadEditorAsync()
    {
        assetSelection?.Cancel();
        assetSelection = null;
        selectedPosterAsset = null;
        DetachEditor();
        renderVersion++;
        await ReleasePreviewAsync();
        previewUrl = string.Empty;
        renderResult = null;
        scenePresentation = null;
        canvasEditor = null;
        designFunc = null;
        loadError = string.Empty;
        renderError = string.Empty;
        saveNotice = string.Empty;
        requestedSnapshot = string.Empty;
        compatibilityToastShown = false;
        loadedCanvasId = CanvasId;
        loadedInstanceCanvasJson = InstanceCanvasJson;
        mobileTextContentEditor = null;
        mobileTextContentTarget = null;
        observedSelectionId = string.Empty;
        presentation.Reset();
        appliedInitialMobileToolId = null;

        if (string.IsNullOrWhiteSpace(CanvasId))
        {
            loadError = "模板标识无效。";
            return;
        }

        try
        {
            WMCanvas? sourceCanvas;
            if (InstanceMode && !string.IsNullOrWhiteSpace(InstanceCanvasJson))
            {
                sourceCanvas = Global.ReadConfig(InstanceCanvasJson);
            }
            else
            {
                var templates = await TemplateLibrary.GetOrRefreshAsync();
                sourceCanvas = templates.FirstOrDefault(item =>
                    string.Equals(item.ID, CanvasId, StringComparison.Ordinal))?.Canvas
                    ?? await Global.GetCanvas(CanvasId);
            }
            if (sourceCanvas is null)
            {
                loadError = "模板加载失败，请重试。";
                return;
            }

            var loadedCanvas = CloneCanvas(sourceCanvas);
            loadedCanvas.Exif.TryAdd(loadedCanvas.ID, ExifHelper.DefaultMeta);
            // Font refresh may require the network for a newly downloaded
            // template. The editor must still open offline with local or
            // fallback fonts instead of replacing the canvas with an error.
            try { await Global.InitFonts([loadedCanvas]); }
            catch { }
            try
            {
                designFunc = await ClientInstance.GetWMDesignFunc(CanvasId);
            }
            catch (NotImplementedException)
            {
                designFunc = new WMDesignFunc();
            }
            designFunc ??= new WMDesignFunc();
            designFunc.CurrentCanvas = loadedCanvas;

            originalCanvasJson = Global.CanvasSerialize(loadedCanvas);
            var persistedDraft = WorkspaceController.TemplateDraft;
            if (persistedDraft is not null
                && string.Equals(persistedDraft.TemplateId, CanvasId, StringComparison.Ordinal))
            {
                try
                {
                    editor = WMTemplateEditorState.Restore(
                        loadedCanvas,
                        persistedDraft.EditorState);
                }
                catch
                {
                    editor = WMTemplateEditorState.Create(loadedCanvas);
                    await WorkspaceController.ClearTemplateDraftAsync();
                }
            }
            else
            {
                editor = WMTemplateEditorState.Create(loadedCanvas);
            }
            editor.Changed += HandleEditorChanged;
            editor.DetailedChanged += HandleEditorDetailedChanged;
            observedSelectionId = editor.SelectedControlId ?? string.Empty;
            if (OpenInitialMobileTool())
            {
                // The workspace requested one of the canvas configuration
                // sections; do not replace it with the last selected object.
            }
            else if (!Global.IsMobile && !string.IsNullOrWhiteSpace(observedSelectionId))
                OpenDefaultProperties();
            PublishToolState();
            await RequestSceneAsync(
                WMTemplateChangeSet.Initial(editor.CurrentRevision),
                force: true);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private static WMCanvas CloneCanvas(WMCanvas source)
    {
        var clone = Global.ReadConfig(Global.CanvasSerialize(source));
        clone.Path = source.Path;
        clone.Exif = source.Exif?.ToDictionary(
            pair => pair.Key,
            pair => new Dictionary<string, string>(pair.Value),
            StringComparer.Ordinal) ?? [];
        return clone;
    }

    private void HandleEditorChanged()
    {
        PublishToolState();
        var selectedId = editor?.SelectedControlId ?? string.Empty;
        if (!string.Equals(selectedId, observedSelectionId, StringComparison.Ordinal))
        {
            observedSelectionId = selectedId;
            if (assetSelection is not null
                && !string.Equals(selectedId, assetSelection.TargetControlId, StringComparison.Ordinal))
            {
                _ = InvokeAsync(async () =>
                {
                    await CancelAssetSelectionAsync();
                    if (!Global.IsMobile && !string.IsNullOrWhiteSpace(selectedId))
                        OpenDefaultProperties();
                    StateHasChanged();
                });
            }
            else if (mobileTextContentTarget is not null
                && !string.Equals(selectedId, mobileTextContentTarget.ID, StringComparison.Ordinal))
            {
                _ = InvokeAsync(async () =>
                {
                    await CancelMobileTextContent();
                    if (!Global.IsMobile && !string.IsNullOrWhiteSpace(selectedId))
                        OpenDefaultProperties();
                    StateHasChanged();
                });
            }
            else if (Global.IsMobile || string.IsNullOrWhiteSpace(selectedId))
            {
                // A canvas selection is a positioning gesture first on mobile.
                // Keep the template available for drag/resize and let the user
                // explicitly choose an editing tool from the contextual rail.
                presentation.ClosePanel();
            }
            else if (presentation.Panel is WMPosterMobilePanel.None
                     || (presentation.Panel == WMPosterMobilePanel.Properties
                         && !MobileTools.Any(tool => string.Equals(
                             tool.Id,
                             presentation.ActiveToolId,
                             StringComparison.Ordinal))))
            {
                OpenDefaultProperties();
            }
        }
        draftDebounce?.Cancel();
        draftDebounce?.Dispose();
        draftDebounce = new CancellationTokenSource();
        TrackDraftTask(PersistDraftAfterDelayAsync(editor, draftDebounce.Token));
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleEditorDetailedChanged(WMTemplateChangeSet changeSet)
    {
        if (changeSet.Phase == WMTemplateChangePhase.Begin
            || changeSet.IsSelectionOnly)
            return;

        _ = InvokeAsync(async () =>
        {
            await RequestSceneAsync(changeSet);
            StateHasChanged();
        });
    }

    private void PublishToolState()
    {
        if (editor is null || WorkspaceController.State.Mode != WMWorkspaceMode.TemplateDesign) return;
        WorkspaceController.UpdateTemplateDesignState(
            editor.SelectedControlId,
            editor.IsDirty,
            editor.IsTransactionActive,
            editor.HistoryCursor,
            editor.HistoryCount);
    }

    private async Task PersistDraftAfterDelayAsync(
        WMTemplateEditorState? source,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(450, cancellationToken);
            if (source is null
                || disposed
                || InstanceMode
                || !ReferenceEquals(editor, source)
                || WorkspaceController.State.Mode != WMWorkspaceMode.TemplateDesign
                || string.IsNullOrWhiteSpace(WorkspaceController.State.SessionId)
                || !source.TryExportDraftState(out var persisted)
                || persisted is null)
                return;
            await WorkspaceController.SaveTemplateDraftAsync(
                new WMWorkspaceTemplateDraft(
                    CanvasId,
                    originalCanvasJson,
                    persisted,
                    DateTime.UtcNow),
                cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (!disposed && ReferenceEquals(editor, source))
            {
                renderError = $"草稿保存失败：{ex.Message}";
                Common.ShowToast(Popup, renderError, isError: true);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void TrackDraftTask(Task task)
    {
        lock (draftTaskGate) draftTasks.Add(task);
        _ = task.ContinueWith(
            _ =>
            {
                lock (draftTaskGate) draftTasks.Remove(task);
            },
            CancellationToken.None,
            TaskContinuationOptions.ExecuteSynchronously,
            TaskScheduler.Default);
    }

    private void AddControl(Type controlType, string label)
    {
        var currentEditor = editor;
        if (currentEditor is null) return;

        IWMControl? added = null;
        currentEditor.Mutate(
            label,
            () =>
            {
                added = WMControlTree.Add(currentEditor.Draft, controlType, null);
                if (added is WMLogo)
                    WMPosterAssetSlots.Ensure(currentEditor.Draft, added);
            },
            WMTemplateChangeKind.Layout | WMTemplateChangeKind.Order | WMTemplateChangeKind.Paint,
            []);
        if (added is null) return;
        currentEditor.Select(added.ID);
        if (added is WMLogo)
            OpenAssetLibrary(added);
        else
            OpenDefaultProperties();
    }

    private void AddControlFromPanel(Type controlType) => AddControl(
        controlType,
        controlType == typeof(WMText) ? "添加文字"
        : controlType == typeof(WMLogo) ? "添加图片"
        : controlType == typeof(WMLine) ? "添加线条"
        : "添加容器");

    private Task ActivateMobileToolByIdAsync(string toolId)
    {
        var tool = MobileTools.FirstOrDefault(item => string.Equals(item.Id, toolId, StringComparison.Ordinal));
        return tool is null ? Task.CompletedTask : ActivateMobileToolAsync(tool);
    }

    private bool OpenInitialMobileTool()
    {
        if (string.IsNullOrWhiteSpace(InitialMobileToolId)
            || string.Equals(appliedInitialMobileToolId, InitialMobileToolId, StringComparison.Ordinal))
            return false;

        var tool = WMPosterEditorPresentationState.CanvasConfigurationTools()
            .FirstOrDefault(item => string.Equals(item.Id, InitialMobileToolId, StringComparison.Ordinal));
        if (tool is null)
            return false;

        presentation.Open(tool);
        appliedInitialMobileToolId = InitialMobileToolId;
        return true;
    }

    private async Task ActivateMobileToolAsync(WMPosterContextToolSpec tool)
    {
        if (tool.Panel == WMPosterMobilePanel.AssetLibrary)
        {
            OpenAssetLibrary(SelectedControl);
            return;
        }

        if (tool.Panel == WMPosterMobilePanel.TextContent)
        {
            OpenMobileTextContent();
            return;
        }

        if (mobileTextContentTarget is not null)
            await CancelMobileTextContent();
        presentation.Open(tool);
        StateHasChanged();
    }

    private void OpenDefaultProperties()
    {
        var tool = MobileTools.FirstOrDefault(item => item.Panel == WMPosterMobilePanel.Properties);
        if (tool is not null)
            presentation.Open(tool);
        else
            presentation.Open(WMPosterMobilePanel.Properties);
    }

    private bool OpenToolForPanel(WMPosterMobilePanel panel)
    {
        var tool = MobileTools.FirstOrDefault(item => item.Panel == panel);
        if (tool is null)
            return false;

        presentation.Open(tool);
        return true;
    }

    private Task OpenAssetLibraryFromInspectorAsync(IWMControl control)
    {
        OpenAssetLibrary(control);
        return Task.CompletedTask;
    }

    private void OpenAssetLibrary(IWMControl? control)
    {
        var currentEditor = editor;
        if (currentEditor is null || control is null || !WMPosterAssetSlots.Supports(control))
            return;
        if (mobileTextContentTarget is not null)
        {
            Common.ShowToast(Popup, "请先完成文字内容编辑。");
            return;
        }
        if (assetSelection is not null)
        {
            if (string.Equals(assetSelection.TargetControlId, control.ID, StringComparison.Ordinal))
                return;
            Common.ShowToast(Popup, "请先完成当前素材替换。");
            return;
        }

        try
        {
            assetSelection = WMPosterAssetSelectionSession.Begin(currentEditor, control);
            selectedPosterAsset = null;
            if (!OpenToolForPanel(WMPosterMobilePanel.AssetLibrary))
                presentation.Open(WMPosterMobilePanel.AssetLibrary, WMMobileEditorSpace.Large);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Common.ShowToast(Popup, ex.Message, isError: control.IsLocked == false);
        }
    }

    private Task PreviewAssetAsync(WMPosterAssetReference asset)
    {
        try
        {
            assetSelection?.Preview(asset);
            selectedPosterAsset = asset;
        }
        catch (Exception ex)
        {
            Common.ShowToast(Popup, ex.Message, isError: true);
        }
        return Task.CompletedTask;
    }

    private async Task ConfirmAssetSelectionAsync()
    {
        var session = assetSelection;
        var asset = selectedPosterAsset;
        if (session is null || asset is null || !session.CanConfirm) return;
        assetSelection = null;
        selectedPosterAsset = null;
        presentation.ClosePanel();
        session.Confirm();
        try
        {
            await PosterAssets.RememberUseAsync(asset);
        }
        catch (Exception ex)
        {
            Common.ShowToast(Popup, $"素材已替换，但最近记录保存失败：{ex.Message}", isError: true);
        }
        StateHasChanged();
    }

    private Task OpenAssetCropAsync()
    {
        if (assetSelection?.CanConfirm != true) return Task.CompletedTask;
        presentation.OpenRelatedPanel(
            WMPosterMobilePanel.AssetCrop,
            WMMobileEditorSpace.Medium);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ReturnToAssetLibrary()
    {
        if (assetSelection is null) return Task.CompletedTask;
        if (!OpenToolForPanel(WMPosterMobilePanel.AssetLibrary))
            presentation.Open(WMPosterMobilePanel.AssetLibrary, WMMobileEditorSpace.Large);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task PreviewAssetFitAsync(WMPosterAssetFit fit)
    {
        try
        {
            assetSelection?.PreviewFit(fit);
        }
        catch (Exception ex)
        {
            Common.ShowToast(Popup, ex.Message, isError: true);
        }
        return Task.CompletedTask;
    }

    private Task PreviewAssetCropAsync(WMCropSettings settings)
    {
        try
        {
            assetSelection?.PreviewCrop(settings);
        }
        catch (Exception ex)
        {
            Common.ShowToast(Popup, ex.Message, isError: true);
        }
        return Task.CompletedTask;
    }

    private async Task HandleAssetEditToolAsync(string toolId)
    {
        if (string.Equals(toolId, "replace", StringComparison.Ordinal))
        {
            await ReturnToAssetLibrary();
            return;
        }

        if (string.Equals(toolId, "crop", StringComparison.Ordinal))
            return;

        var currentEditor = editor;
        var logo = AssetTargetLogo;
        if (currentEditor is null || logo is null)
            return;

        switch (toolId)
        {
            case "white-transparent":
                currentEditor.Mutate(
                    "切换白色转透明",
                    () => logo.White2Transparent = !logo.White2Transparent,
                    WMTemplateChangeKind.Paint,
                    [logo.ID]);
                break;
            case "lock-ratio":
                currentEditor.SetLogoAspectRatioLocked(
                    logo.ID,
                    !currentEditor.IsLogoAspectRatioLocked(logo.ID));
                break;
        }

        StateHasChanged();
    }

    private Task CancelAssetSelectionAsync()
    {
        var session = assetSelection;
        if (session is null) return Task.CompletedTask;
        assetSelection = null;
        selectedPosterAsset = null;
        presentation.ClosePanel();
        session.Cancel();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenMobileTextContent()
    {
        var currentEditor = editor;
        if (currentEditor is null
            || SelectedControl is not WMText text
            || mobileTextContentTarget is not null)
            return;

        if (text.IsLocked)
        {
            Common.ShowToast(Popup, "文字图层已锁定，解锁后再编辑。");
            return;
        }

        if (currentEditor.IsTransactionActive)
        {
            Common.ShowToast(Popup, "请先完成当前属性调整。");
            return;
        }

        mobileTextContentTarget = text;
        currentEditor.BeginTransaction(
            "配置文字内容",
            WMTemplateChangeKind.Resource | WMTemplateChangeKind.Layout | WMTemplateChangeKind.Paint,
            [text.ID]);
        if (!OpenToolForPanel(WMPosterMobilePanel.TextContent))
            presentation.Open(WMPosterMobilePanel.TextContent, WMMobileEditorSpace.Medium);
        StateHasChanged();
    }

    private Task OpenMobileTextContentFromInspector(WMText text)
    {
        if (SelectedControl is WMText selected
            && ReferenceEquals(selected, text))
            OpenMobileTextContent();
        return Task.CompletedTask;
    }

    private void CompleteMobileTextContent(WMText text)
    {
        if (mobileTextContentTarget is null) return;
        mobileTextContentEditor = null;
        mobileTextContentTarget = null;
        presentation.ClosePanel();
        editor?.CommitTransaction();
        StateHasChanged();
    }

    private Task CancelMobileTextContent()
    {
        if (mobileTextContentTarget is null)
            return Task.CompletedTask;

        mobileTextContentEditor = null;
        mobileTextContentTarget = null;
        presentation.ClosePanel();
        editor?.CancelTransaction();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CloseMobilePanelAsync()
    {
        if (assetSelection is not null)
            await CancelAssetSelectionAsync();
        else if (mobileTextContentTarget is not null)
            await CancelMobileTextContent();
        else
        {
            presentation.ClosePanel();
            StateHasChanged();
        }
    }

    private void HandleFieldLibraryVisibilityChanged(bool isOpen)
    {
        presentation.SetTextFieldLibraryOpen(isOpen);
        StateHasChanged();
    }

    private static string ControlName(IWMControl control) =>
        string.IsNullOrWhiteSpace(control.Name)
            ? control switch
            {
                WMContainer => "容器",
                WMText => "文字",
                WMLogo => "图片",
                WMLine => "线条",
                _ => "图层"
            }
            : control.Name;

    private async Task RequestSceneAsync(
        WMTemplateChangeSet changeSet,
        bool force = false)
    {
        var currentEditor = editor;
        if (currentEditor is null || disposed) return;

        var snapshotJson = Global.CanvasSerialize(currentEditor.Draft);
        var previewFingerprint = BuildPreviewFingerprint(currentEditor.Draft, snapshotJson);
        if (!force && string.Equals(previewFingerprint, requestedSnapshot, StringComparison.Ordinal))
            return;

        requestedSnapshot = previewFingerprint;
        var version = ++renderVersion;
        isRendering = true;
        renderError = string.Empty;
        saveNotice = string.Empty;
        StateHasChanged();

        try
        {
            var preview = await DesignerSession.RenderSceneAsync(
                $"template-designer:{CanvasId}",
                currentEditor.Draft,
                changeSet,
                changeSet.Phase == WMTemplateChangePhase.Update
                    ? WMDesignSceneQuality.Interactive
                    : WMDesignSceneQuality.Exact,
                publishObjectUrl: Global.DeviceType is Watermark.Shared.Enums.DeviceType.Mac or Watermark.Shared.Enums.DeviceType.Win,
                surfaceCacheBudgetBytes: InteractionProfiles.Current.SceneCacheBudgetBytes);
            if (preview is null || !IsCurrentRender(currentEditor, version)) return;

            renderResult = preview.RenderResult;
            previewUrl = preview.PreviewUrl;
            scenePresentation = preview.Scene;
            if (preview.UsesCompatibilityFallback && !sceneFallbackToastShown)
            {
                sceneFallbackToastShown = true;
                Common.ShowToast(Popup, "分层场景初始化失败，已切换兼容预览。", isError: true);
            }
            if (scenePresentation?.UsesInlineFallback == true
                && !compatibilityToastShown)
            {
                compatibilityToastShown = true;
                Common.ShowToast(Popup, "当前 WebView 不支持分层位图直传，已切换兼容显示。");
            }
        }
        catch (Exception ex)
        {
            if (IsCurrentRender(currentEditor, version))
            {
                requestedSnapshot = string.Empty;
                renderError = ex.Message;
                Common.ShowToast(Popup, renderError, isError: true);
            }
        }
        finally
        {
            if (IsCurrentRender(currentEditor, version))
            {
                isRendering = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentRender(WMTemplateEditorState source, long version) =>
        !disposed && ReferenceEquals(editor, source) && renderVersion == version;

    private static string BuildPreviewFingerprint(WMCanvas canvas, string serializedCanvas) =>
        string.Concat(
            serializedCanvas,
            "\npath:", canvas.Path,
            "\nexif:", System.Text.Json.JsonSerializer.Serialize(canvas.Exif));

    private Task SaveAsync() => SaveCoreAsync();

    private async Task<bool> SaveCoreAsync()
    {
        var currentEditor = editor;
        if (currentEditor is null || isSaving) return false;
        if (assetSelection is not null)
        {
            Common.ShowToast(Popup, "请先确认或取消素材替换。");
            return false;
        }
        if (mobileTextContentTarget is not null)
        {
            Common.ShowToast(Popup, "请先完成文字内容编辑。");
            return false;
        }

        isSaving = true;
        saveNotice = string.Empty;
        renderError = string.Empty;
        StateHasChanged();
        try
        {
            draftDebounce?.Cancel();
            await DesignerSession.FlushRenderAsync();
            WMPosterTemplateMigration.Normalize(currentEditor.Draft);
            if (InstanceMode)
            {
                var validation = WMTemplateValidator.Validate(
                    currentEditor.Draft,
                    Path.Combine(Global.AppPath.TemplatesFolder, CanvasId));
                var blocking = validation
                    .Where(error => error.Severity == WMValidationSeverity.Error)
                    .ToList();
                if (blocking.Count > 0)
                    throw new WMTemplateValidationException(blocking);
                await OnInstanceCompleted.InvokeAsync(CloneCanvas(currentEditor.Draft));
            }
            else
            {
                await TemplateStore.SaveAsync(currentEditor.Draft);
            }
            currentEditor.MarkSaved();
            if (!InstanceMode && WorkspaceController.State.Mode == WMWorkspaceMode.TemplateDesign)
                await WorkspaceController.ClearTemplateDraftAsync();
            saveNotice = InstanceMode ? "海报已应用到当前工作台" : "模板已保存";
            Common.ShowToast(Popup, saveNotice);
            if (!InstanceMode)
            {
                try
                {
                    await OnSaved.InvokeAsync(currentEditor.Draft.ID);
                }
                catch (Exception ex)
                {
                    renderError = ex.Message;
                    Common.ShowToast(Popup, renderError, isError: true);
                }
            }
            return true;
        }
        catch (WMTemplateValidationException ex)
        {
            var first = ex.Errors.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(first?.ControlId))
                currentEditor.Select(first.ControlId);
            renderError = first?.Message ?? ex.Message;
            Common.ShowToast(Popup, renderError, isError: true);
            return false;
        }
        catch (Exception ex)
        {
            renderError = ex.Message;
            Common.ShowToast(Popup, renderError, isError: true);
            return false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    public async Task RequestExitAsync()
    {
        if (editor is null || !editor.IsDirty)
        {
            await OnClose.InvokeAsync();
            return;
        }

        showExitDialog = true;
    }

    private Task ToolbarExitAsync() =>
        Global.IsMobile ? HandleBackAsync() : RequestExitAsync();

    public async Task HandleBackAsync()
    {
        if (showExitDialog)
        {
            ContinueEditing();
            return;
        }
        if (presentation.Panel == WMPosterMobilePanel.TextContent)
        {
            if (presentation.IsTextFieldLibraryOpen)
            {
                await CloseMobileTextFieldLibraryAsync();
                return;
            }
            await CancelMobileTextContent();
            return;
        }
        if (presentation.Panel == WMPosterMobilePanel.AssetCrop)
        {
            await ReturnToAssetLibrary();
            return;
        }
        if (presentation.Panel == WMPosterMobilePanel.AssetLibrary
            || assetSelection is not null)
        {
            await CancelAssetSelectionAsync();
            return;
        }
        if (presentation.TryClosePanel())
        {
            StateHasChanged();
            return;
        }
        if (canvasEditor is not null
            && await canvasEditor.CancelCurrentGestureAsync())
            return;
        if (editor is not null
            && !string.IsNullOrWhiteSpace(editor.SelectedControlId))
        {
            editor.Select(null);
            return;
        }
        await RequestExitAsync();
    }

    public async Task<bool> CanNavigateAwayAsync()
    {
        if (presentation.Panel == WMPosterMobilePanel.TextContent
            && presentation.IsTextFieldLibraryOpen)
        {
            await CloseMobileTextFieldLibraryAsync();
            return false;
        }
        if (mobileTextContentTarget is not null)
        {
            await CancelMobileTextContent();
            return false;
        }
        if (assetSelection is not null)
        {
            await CancelAssetSelectionAsync();
            return false;
        }
        if (presentation.TryClosePanel())
        {
            StateHasChanged();
            return false;
        }
        if (canvasEditor is not null
            && await canvasEditor.CancelCurrentGestureAsync())
            return false;
        if (editor is not null
            && !string.IsNullOrWhiteSpace(editor.SelectedControlId))
        {
            editor.Select(null);
            return false;
        }
        if (editor is null || !editor.IsDirty) return true;
        showExitDialog = true;
        StateHasChanged();
        return false;
    }

    private async Task CloseMobileTextFieldLibraryAsync()
    {
        presentation.SetTextFieldLibraryOpen(false);
        if (mobileTextContentEditor is not null)
            await mobileTextContentEditor.TryCloseFieldLibraryAsync();
        StateHasChanged();
    }

    private async Task SaveAndExitAsync()
    {
        if (await SaveCoreAsync())
        {
            showExitDialog = false;
            if (!InstanceMode)
                await OnClose.InvokeAsync();
        }
    }

    private async Task DiscardAndExitAsync()
    {
        draftDebounce?.Cancel();
        if (WorkspaceController.State.Mode == WMWorkspaceMode.TemplateDesign)
            await WorkspaceController.ClearTemplateDraftAsync();
        showExitDialog = false;
        await OnClose.InvokeAsync();
    }

    private void ContinueEditing() => showExitDialog = false;

    private Task UndoAsync()
    {
        editor?.Undo();
        return Task.CompletedTask;
    }

    private Task RedoAsync()
    {
        editor?.Redo();
        return Task.CompletedTask;
    }

    private async Task FitAsync()
    {
        if (canvasEditor is not null)
            await canvasEditor.FitAsync();
    }

    private Task SetZoomAsync(double value)
    {
        var next = Math.Clamp(value, 0.1, 4);
        if (Math.Abs(next - zoom) < 0.0005)
            return Task.CompletedTask;

        zoom = next;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await HandleBackAsync();
            return;
        }

        if (!(args.MetaKey || args.CtrlKey)) return;
        if (string.Equals(args.Key, "s", StringComparison.OrdinalIgnoreCase))
            await SaveAsync();
        else if (string.Equals(args.Key, "z", StringComparison.OrdinalIgnoreCase) && args.ShiftKey)
            await RedoAsync();
        else if (string.Equals(args.Key, "z", StringComparison.OrdinalIgnoreCase))
            await UndoAsync();
    }

    private void DetachEditor()
    {
        if (editor is not null)
        {
            editor.Changed -= HandleEditorChanged;
            editor.DetailedChanged -= HandleEditorDetailedChanged;
        }
        editor = null;
    }

    private async Task ReleasePreviewAsync()
    {
        await DesignerSession.ClearAsync();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        assetSelection?.Cancel();
        assetSelection = null;
        selectedPosterAsset = null;
        renderVersion++;
        draftDebounce?.Cancel();
        draftDebounce?.Dispose();
        draftDebounce = null;
        Task[] pendingDrafts;
        lock (draftTaskGate) pendingDrafts = draftTasks.ToArray();
        if (pendingDrafts.Length > 0)
        {
            try { await Task.WhenAll(pendingDrafts); }
            catch (OperationCanceledException) { }
        }
        DetachEditor();
        await ReleasePreviewAsync();
        previewUrl = string.Empty;
    }
#nullable restore
}
