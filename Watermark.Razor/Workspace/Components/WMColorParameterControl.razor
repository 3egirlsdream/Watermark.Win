@namespace Watermark.Razor.Workspace.Components

<WmNumericSlider Label="@Label"
                 Value="@Value"
                 Min="@Minimum" Max="@Maximum" Step="@Step" Unit="@Unit"
                 Disabled="@Disabled"
                 ShowLabel="@ShowHeader"
                 CssClass="@CssClass"
                 ValueChanged="PreviewAsync"
                 InteractionStarted="BeginInteractionAsync"
                 InteractionEnded="CommitAsync" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public float Value { get; set; }
    [Parameter] public double Minimum { get; set; } = -100;
    [Parameter] public double Maximum { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<float> PreviewValueChanged { get; set; }
    [Parameter] public EventCallback<float> CommitValueChanged { get; set; }

    private bool interactionActive;
    private float pendingValue;

    protected override void OnParametersSet()
    {
        if (!interactionActive) pendingValue = Value;
    }

    private Task BeginInteractionAsync()
    {
        interactionActive = true;
        pendingValue = Value;
        return Task.CompletedTask;
    }

    private async Task PreviewAsync(double value)
    {
        if (!interactionActive) await BeginInteractionAsync();
        pendingValue = (float)value;
        await PreviewValueChanged.InvokeAsync(pendingValue);
    }

    private Task CommitAsync()
    {
        if (!interactionActive) return Task.CompletedTask;
        interactionActive = false;
        return CommitValueChanged.InvokeAsync(pendingValue);
    }
}
