@using Watermark.Razor.Workspace
@using Watermark.Shared.Enums
@using Watermark.Shared.Models
@implements IDisposable

<aside class="@InspectorClass" aria-label="属性检查器">
    <header class="selection-header">
        <div class="selection-heading-row">
            <input class="selection-name-input" value="@CurrentName" disabled="@IsReadOnly" @onchange="RenameCurrent" @onkeydown:stopPropagation aria-label="名称" />
            <span class="selection-type">@CurrentTypeName</span>
            @if (CloseRequested.HasDelegate)
            {
                <button type="button" class="selection-close" aria-label="关闭属性面板" @onclick="CloseRequested">
                    <WmIcon Icon="x" />
                </button>
            }
        </div>
        <div class="selection-breadcrumb" title="@Breadcrumb">@Breadcrumb</div>
        @if (SelectedControl is not null)
        {
            <div class="selection-header-actions">
                <MButton Icon Text Small title="显示或隐藏" aria-label="显示或隐藏图层" OnClick="ToggleSelectedVisible">
                    <WmIcon Size="15" Icon="@(SelectedControl.Enabled ? "eye" : "eye-slash")" />
                </MButton>
                <MButton Icon Text Small title="锁定或解锁" aria-label="锁定或解锁图层" OnClick="ToggleSelectedLocked">
                    <WmIcon Size="15" Icon="@(SelectedControl.IsLocked ? "lock" : "lock-open")" />
                </MButton>
                <MButton Icon Text Small title="复制" aria-label="复制图层" OnClick="DuplicateSelected">
                    <WmIcon Size="15" Icon="copy" />
                </MButton>
                <MButton Icon Text Small title="删除" aria-label="删除图层" OnClick="RequestDeleteSelected">
                    <WmIcon Size="15" Icon="trash" />
                </MButton>
            </div>
        }
    </header>

    <div class="selection-inspector-scroll" @onkeydown:stopPropagation>
        @if (SelectedControl is null)
        {
            @if (Show(WMTemplateMobileInspectorSection.Canvas))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>画布</h3></div>
                <MacInspectorOptionGroup TValue="CanvasType" Label="类型"
                                         Value="@Editor.Draft.CanvasType"
                                         Options="@CanvasTypeOptions"
                                         ValueChanged="value => SetCanvasType(value)" />
                <MacColorInput Label="背景颜色"
                               Value="@Editor.Draft.BackgroundColor"
                               ValueChanged='value => Mutate("修改画布背景", () => Editor.Draft.BackgroundColor = value)' />
                <div class="resource-field">
                    <div><span>默认图片</span><small>@ResourceName(Editor.Draft.Path)</small></div>
                    <MButton Text Small OnClick="PickCanvasImageAsync">选择</MButton>
                    <MButton Text Small Disabled="@string.IsNullOrWhiteSpace(Editor.Draft.Path)" OnClick="ClearCanvasImage">清除</MButton>
                </div>
            </section>
            }

            @if (Show(WMTemplateMobileInspectorSection.CanvasSize))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>尺寸</h3></div>
                <div class="inspector-two-column">
                    <label class="inspector-field"><span>宽度（像素）</span><input type="number" value="@Editor.Draft.CustomWidth" min="1" @oninput="SetCanvasWidth" @onfocus="BeginSliderAsync" @onblur="EndSliderAsync" /></label>
                    <label class="inspector-field"><span>高度（像素）</span><input type="number" value="@Editor.Draft.CustomHeight" min="1" @oninput="SetCanvasHeight" @onfocus="BeginSliderAsync" @onblur="EndSliderAsync" /></label>
                </div>
                <label class="inspector-field"><span>画布比例</span><input value="@Editor.Draft.LengthWidthRatio" placeholder="例如 3:2" @oninput="SetCanvasRatio" @onfocus="BeginSliderAsync" @onblur="EndSliderAsync" /></label>
            </section>
            }

            @if (Show(WMTemplateMobileInspectorSection.CanvasInsetTop)
                || Show(WMTemplateMobileInspectorSection.CanvasInsetRight)
                || Show(WMTemplateMobileInspectorSection.CanvasInsetBottom)
                || Show(WMTemplateMobileInspectorSection.CanvasInsetLeft)
                || Show(WMTemplateMobileInspectorSection.CanvasInsets))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>@CanvasInsetHeading</h3></div>
                @if (Show(WMTemplateMobileInspectorSection.CanvasInsetTop) || Show(WMTemplateMobileInspectorSection.CanvasInsets))
                {
                    <MacInspectorSlider Label="上" Value="@Editor.Draft.BorderThickness.Top" Min="0" Max="50" Step="1" Unit="%" ValueChanged='value => SetSlider("调整画布边距", () => Editor.Draft.BorderThickness.Top = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasInsetRight) || Show(WMTemplateMobileInspectorSection.CanvasInsets))
                {
                    <MacInspectorSlider Label="右" Value="@Editor.Draft.BorderThickness.Right" Min="0" Max="50" Step="1" Unit="%" ValueChanged='value => SetSlider("调整画布边距", () => Editor.Draft.BorderThickness.Right = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasInsetBottom) || Show(WMTemplateMobileInspectorSection.CanvasInsets))
                {
                    <MacInspectorSlider Label="下" Value="@Editor.Draft.BorderThickness.Bottom" Min="0" Max="50" Step="1" Unit="%" ValueChanged='value => SetSlider("调整画布边距", () => Editor.Draft.BorderThickness.Bottom = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasInsetLeft) || Show(WMTemplateMobileInspectorSection.CanvasInsets))
                {
                    <MacInspectorSlider Label="左" Value="@Editor.Draft.BorderThickness.Left" Min="0" Max="50" Step="1" Unit="%" ValueChanged='value => SetSlider("调整画布边距", () => Editor.Draft.BorderThickness.Left = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
            </section>
            }

            @if (Show(WMTemplateMobileInspectorSection.CanvasFrame)
                || Show(WMTemplateMobileInspectorSection.CanvasFramePadding)
                || Show(WMTemplateMobileInspectorSection.CanvasFrameCorner)
                || Show(WMTemplateMobileInspectorSection.CanvasFrameShadow)
                || Show(WMTemplateMobileInspectorSection.CanvasFrameBlur))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>外框</h3></div>
                @if (Show(WMTemplateMobileInspectorSection.CanvasFrame))
                {
                    <div class="inspector-switch-grid" aria-label="外框操作">
                        <MacInspectorSwitch Label="启用外框" Value="@Editor.Draft.FrameProperties.Enabled" ValueChanged='value => Mutate("切换外框", () => Editor.Draft.FrameProperties.Enabled = value)' />
                        <MacInspectorSwitch Label="背景透明" Value="@Editor.Draft.FrameProperties.BeforeBkTransparent" ValueChanged='value => Mutate("切换外框背景", () => Editor.Draft.FrameProperties.BeforeBkTransparent = value)' />
                        <MacInspectorSwitch Label="圆角" Value="@Editor.Draft.FrameProperties.EnableRadius" ValueChanged='value => Mutate("切换外框圆角", () => Editor.Draft.FrameProperties.EnableRadius = value)' />
                        <MacInspectorSwitch Label="阴影" Value="@Editor.Draft.FrameProperties.EnableShadow" ValueChanged='value => Mutate("切换外框阴影", () => Editor.Draft.FrameProperties.EnableShadow = value)' />
                        <MacInspectorSwitch Label="背景模糊" Value="@Editor.Draft.FrameProperties.EnableGaussianBlur" ValueChanged='value => Mutate("切换外框模糊", () => Editor.Draft.FrameProperties.EnableGaussianBlur = value)' />
                    </div>
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasFramePadding) || Show(WMTemplateMobileInspectorSection.CanvasFrame))
                {
                    <MacInspectorSlider Label="外框留白" Value="@Editor.Draft.FrameProperties.BorderPadding" Min="0" Max="50" Step="1" Unit="%" ValueChanged='value => SetSlider("调整外框留白", () => Editor.Draft.FrameProperties.BorderPadding = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasFrameCorner) || Show(WMTemplateMobileInspectorSection.CanvasFrame))
                {
                    @if (Editor.Draft.FrameProperties.EnableRadius)
                    {
                        <MacInspectorSlider Label="圆角半径" Value="@Editor.Draft.FrameProperties.CornerRadius" Min="0" Max="200" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整外框圆角", () => Editor.Draft.FrameProperties.CornerRadius = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“外框”中开启圆角后可调整半径。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasFrameShadow) || Show(WMTemplateMobileInspectorSection.CanvasFrame))
                {
                    @if (Editor.Draft.FrameProperties.EnableShadow)
                    {
                        <MacInspectorSlider Label="阴影范围" Value="@Editor.Draft.FrameProperties.ShadowRange" Min="0" Max="100" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整外框阴影", () => Editor.Draft.FrameProperties.ShadowRange = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                        <MacColorInput Label="阴影颜色" Value="@Editor.Draft.FrameProperties.ShadowColor" ValueChanged='value => Mutate("修改外框阴影颜色", () => Editor.Draft.FrameProperties.ShadowColor = value)' />
                    }
                    else { <p class="inspector-operation-hint">在“外框”中开启阴影后可调整样式。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasFrameBlur) || Show(WMTemplateMobileInspectorSection.CanvasFrame))
                {
                    @if (Editor.Draft.FrameProperties.EnableGaussianBlur)
                    {
                        <MacInspectorSlider Label="模糊强度" Value="@Editor.Draft.FrameProperties.GaussianDeep" Min="0" Max="60" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整外框模糊", () => Editor.Draft.FrameProperties.GaussianDeep = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“外框”中开启背景模糊后可调整强度。</p> }
                }
            </section>
            }

            @if (Show(WMTemplateMobileInspectorSection.CanvasImage)
                || Show(WMTemplateMobileInspectorSection.CanvasImageCorner)
                || Show(WMTemplateMobileInspectorSection.CanvasImageShadow)
                || Show(WMTemplateMobileInspectorSection.CanvasImageBlur))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>图片效果</h3></div>
                @if (Show(WMTemplateMobileInspectorSection.CanvasImage))
                {
                    <div class="inspector-switch-grid" aria-label="图片操作">
                        <MacInspectorSwitch Label="显示图片" Value="@Editor.Draft.ImageProperties.Show" ValueChanged='value => Mutate("切换默认图片", () => Editor.Draft.ImageProperties.Show = value)' />
                        <MacInspectorSwitch Label="圆角" Value="@Editor.Draft.ImageProperties.EnableRadius" ValueChanged='value => Mutate("切换圆角", () => Editor.Draft.ImageProperties.EnableRadius = value)' />
                        <MacInspectorSwitch Label="阴影" Value="@Editor.Draft.ImageProperties.EnableShadow" ValueChanged='value => Mutate("切换阴影", () => Editor.Draft.ImageProperties.EnableShadow = value)' />
                        <MacInspectorSwitch Label="高斯模糊" Value="@Editor.Draft.ImageProperties.EnableGaussianBlur" ValueChanged='value => Mutate("切换模糊", () => Editor.Draft.ImageProperties.EnableGaussianBlur = value)' />
                    </div>
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasImageCorner) || Show(WMTemplateMobileInspectorSection.CanvasImage))
                {
                    @if (Editor.Draft.ImageProperties.EnableRadius)
                    {
                        <MacInspectorSlider Label="圆角半径" Value="@Editor.Draft.ImageProperties.CornerRadius" Min="0" Max="200" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整圆角", () => Editor.Draft.ImageProperties.CornerRadius = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启圆角后可调整半径。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasImageShadow) || Show(WMTemplateMobileInspectorSection.CanvasImage))
                {
                    @if (Editor.Draft.ImageProperties.EnableShadow)
                    {
                        <MacInspectorSlider Label="阴影范围" Value="@Editor.Draft.ImageProperties.ShadowRange" Min="0" Max="100" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整阴影", () => Editor.Draft.ImageProperties.ShadowRange = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                        <MacColorInput Label="阴影颜色" Value="@Editor.Draft.ImageProperties.ShadowColor" ValueChanged='value => Mutate("修改阴影颜色", () => Editor.Draft.ImageProperties.ShadowColor = value)' />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启阴影后可调整样式。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.CanvasImageBlur) || Show(WMTemplateMobileInspectorSection.CanvasImage))
                {
                    @if (Editor.Draft.ImageProperties.EnableGaussianBlur)
                    {
                        <MacInspectorSlider Label="模糊强度" Value="@Editor.Draft.ImageProperties.GaussianDeep" Min="0" Max="60" Step="1" Unit="像素" ValueChanged='value => SetSlider("调整模糊", () => Editor.Draft.ImageProperties.GaussianDeep = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启高斯模糊后可调整强度。</p> }
                }
            </section>
            }
        }
        else if (SelectedControl is WMContainer container)
        {
            @if (Show(WMTemplateMobileInspectorSection.Container))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>容器</h3></div>
                @if (Section is null)
                {
                    <div class="resource-field">
                        <div><span>图片</span><small>@ResourceName(container.Path)</small></div>
                        <MButton Text Small Disabled="@IsReadOnly" OnClick="() => RequestAssetEditAsync(container)">资源库</MButton>
                        <MButton Text Small Disabled="@(IsReadOnly || string.IsNullOrWhiteSpace(container.Path))" OnClick='() => Mutate("清除容器图片", () => container.Path = string.Empty)'>清除</MButton>
                    </div>
                }
                <MacInspectorSwitch Label="允许作为可替换图片槽"
                                    Value="@(WMPosterAssetSlots.Find(Editor.Draft, container) is not null)"
                                    Disabled="@IsReadOnly"
                                    ValueChanged="value => SetAssetSlotAsync(container, value)" />
                @if (Editor.Draft.CanvasType == CanvasType.Split)
                {
                    <MacInspectorSwitch Label="固定图片" Value="@container.ContainerProperties.FixImage" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换固定图片", () => container.ContainerProperties.FixImage = value)' />
                }
                <MacColorInput Label="背景颜色" Value="@container.BackgroundColor" Disabled="@IsReadOnly" ValueChanged='value => Mutate("修改容器背景", () => container.BackgroundColor = value)' />
                @if (!IsV2)
                {
                    <MacInspectorOptionGroup TValue="Orientation" Label="内部方向" Value="@container.Orientation" Options="@OrientationOptions"
                                             Disabled="@IsReadOnly" ValueChanged="value => SetContainerOrientation(container, value)" />
                    <MacInspectorOptionGroup TValue="HorizontalAlignment" Label="水平对齐" Value="@container.HorizontalAlignment" Options="@HorizontalAlignmentOptions"
                                             Disabled="@IsReadOnly" ValueChanged="value => SetHorizontalAlignment(container, value)" />
                    <MacInspectorOptionGroup TValue="VerticalAlignment" Label="垂直对齐" Value="@container.VerticalAlignment" Options="@VerticalAlignmentOptions"
                                             Disabled="@IsReadOnly" ValueChanged="value => SetVerticalAlignment(container, value)" />
                    <MacInspectorSlider Label="宽度" Value="@container.WidthPercent" Min="1" Max="100" Step="1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整容器宽度", () => container.WidthPercent = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="高度" Value="@container.HeightPercent" Min="1" Max="100" Step="1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整容器高度", () => container.HeightPercent = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
            </section>
            }
            <MacNodeStyleInspector Editor="@Editor" Control="@container" ReadOnly="@IsReadOnly" Section="@Section" />
            @if (!IsV2 && !IsTopLevelContainer(container) && Show(WMTemplateMobileInspectorSection.Spacing))
            {
                <section class="inspector-group">
                    <div class="inspector-group-heading"><h3>外边距（相对容器）</h3></div>
                    <MacInspectorSlider Label="上" Value="@container.Margin.Top" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => container.Margin.Top = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="右" Value="@container.Margin.Right" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => container.Margin.Right = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="下" Value="@container.Margin.Bottom" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => container.Margin.Bottom = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="左" Value="@container.Margin.Left" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => container.Margin.Left = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                </section>
            }
            @if (Show(WMTemplateMobileInspectorSection.ContainerImage)
                || Show(WMTemplateMobileInspectorSection.ContainerCorner)
                || Show(WMTemplateMobileInspectorSection.ContainerShadow)
                || Show(WMTemplateMobileInspectorSection.ContainerBlur))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>容器效果</h3></div>
                @if (Show(WMTemplateMobileInspectorSection.ContainerImage))
                {
                    <div class="inspector-switch-grid" aria-label="容器图片操作">
                        <MacInspectorSwitch Label="显示图片" Value="@container.ContainerProperties.Show" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换容器图片", () => container.ContainerProperties.Show = value)' />
                        <MacInspectorSwitch Label="裁切图片" Value="@container.EnableCrop" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换图片裁切", () => container.EnableCrop = value)' />
                        <MacInspectorSwitch Label="圆角" Value="@container.ContainerProperties.EnableRadius" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换圆角", () => container.ContainerProperties.EnableRadius = value)' />
                        <MacInspectorSwitch Label="阴影" Value="@container.ContainerProperties.EnableShadow" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换阴影", () => container.ContainerProperties.EnableShadow = value)' />
                        <MacInspectorSwitch Label="背景模糊" Value="@container.ContainerProperties.EnableGaussianBlur" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换背景模糊", () => container.ContainerProperties.EnableGaussianBlur = value)' />
                    </div>
                }
                @if (Show(WMTemplateMobileInspectorSection.ContainerCorner) || Show(WMTemplateMobileInspectorSection.ContainerImage))
                {
                    @if (container.ContainerProperties.EnableRadius)
                    {
                        <MacInspectorSlider Label="圆角半径" Value="@container.ContainerProperties.CornerRadius" Min="0" Max="200" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整圆角", () => container.ContainerProperties.CornerRadius = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启圆角后可调整半径。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.ContainerShadow) || Show(WMTemplateMobileInspectorSection.ContainerImage))
                {
                    @if (container.ContainerProperties.EnableShadow)
                    {
                        <MacInspectorSlider Label="阴影范围" Value="@container.ContainerProperties.ShadowRange" Min="0" Max="100" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整阴影", () => container.ContainerProperties.ShadowRange = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                        <MacColorInput Label="阴影颜色" Value="@container.ContainerProperties.ShadowColor" Disabled="@IsReadOnly" ValueChanged='value => Mutate("修改阴影颜色", () => container.ContainerProperties.ShadowColor = value)' />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启阴影后可调整样式。</p> }
                }
                @if (Show(WMTemplateMobileInspectorSection.ContainerBlur) || Show(WMTemplateMobileInspectorSection.ContainerImage))
                {
                    @if (container.ContainerProperties.EnableGaussianBlur)
                    {
                        <MacInspectorSlider Label="模糊强度" Value="@container.ContainerProperties.GaussianDeep" Min="0" Max="60" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整模糊", () => container.ContainerProperties.GaussianDeep = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    }
                    else { <p class="inspector-operation-hint">在“图片”中开启背景模糊后可调整强度。</p> }
                }
            </section>
            }
            @if ((!IsV2 && IsTopLevelContainer(container)) || (IsV2 && container.Style.Position == WMPosition.Absolute))
            {
                <MacTransformInspector Editor="@Editor" Control="@container" Bounds="@SelectedBounds" ReadOnly="@IsReadOnly" Section="@Section" />
            }
        }
        else if (SelectedControl is WMText text)
        {
            @if (Show(WMTemplateMobileInspectorSection.TextTypography))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>@(Section is null ? "文字" : "字体")</h3></div>
                @if (Section is null)
                {
                    <div class="resource-field">
                        <div><span>文字内容</span><small>@TextContentSummary(text)</small></div>
                        <MButton Text Small Disabled="@IsReadOnly" OnClick="() => RequestTextContentEditAsync(text)">编辑</MButton>
                    </div>
                }
                <div class="text-font-picker-row">
                    <div class="inspector-field">
                        <span>字体</span>
                        <WmSelect TValue="string"
                                  Value="@text.FontFamily"
                                  ValueChanged="value => SetFontFamily(text, value)"
                                  Options="@FontOptions"
                                  AriaLabel="字体"
                                  Disabled="@IsReadOnly" />
                    </div>
                    <MButton Text Small Class="wide-secondary-command" Disabled="@IsReadOnly" OnClick="ImportFontAsync">导入</MButton>
                </div>
                <MacInspectorSlider Label="字号" Value="@text.FontSize" Min="@(IsV2 ? 0.1 : 6)" Max="@(IsV2 ? 25 : 160)" Step="@(IsV2 ? 0.1 : 1)" Unit="@(IsV2 ? "% 短边" : "像素")" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整字号", () => text.FontSize = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                @if (IsV2)
                {
                    <MacInspectorSlider Label="字距" Value="@text.LetterSpacing" Min="-1" Max="3" Step="0.05" Unit="% 短边" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整字距", () => text.LetterSpacing = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
                <MacColorInput Label="文字颜色" Value="@text.FontColor" Disabled="@IsReadOnly" ValueChanged='value => Mutate("修改文字颜色", () => text.FontColor = value)' />
            </section>
            }

            @if (Show(WMTemplateMobileInspectorSection.TextFormat))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>排版</h3></div>
                <div class="text-style-buttons" role="group" aria-label="文字样式">
                    <MButton Text Small Class="@TextStyleClass(text.IsBold)" Disabled="@IsReadOnly" OnClick='() => Mutate("切换粗体", () => text.IsBold = !text.IsBold)'><WmIcon Size="16" Icon="text-b" />粗体</MButton>
                    <MButton Text Small Class="@TextStyleClass(text.IsItalic)" Disabled="@IsReadOnly" OnClick='() => Mutate("切换斜体", () => text.IsItalic = !text.IsItalic)'><WmIcon Size="16" Icon="text-italic" />斜体</MButton>
                </div>
                <MacInspectorSwitch Label="自动换行" Value="@text.TextWrap" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换文字换行", () => text.TextWrap = value)' />
                <div class="inspector-field">
                    <span>关联容器</span>
                    <WmSelect TValue="string"
                              Value="@(text.BindedContainerId ?? string.Empty)"
                              ValueChanged="value => SetBoundContainer(text, value)"
                              Options="@BoundContainerOptions"
                              AriaLabel="关联容器"
                              Disabled="@IsReadOnly" />
                </div>
            </section>
            }
            <MacNodeStyleInspector Editor="@Editor" Control="@text" ReadOnly="@IsReadOnly" Section="@Section" />
            @if (IsV2 && text.Style.Position == WMPosition.Absolute)
            {
                <MacTransformInspector Editor="@Editor" Control="@text" Bounds="@SelectedBounds" ReadOnly="@IsReadOnly" Section="@Section" />
            }
            @if (Show(WMTemplateMobileInspectorSection.TextBorder))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>文字边框</h3></div>
                <MacInspectorSwitch Label="启用边框" Value="@text.EnableBorder" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换文字边框", () => text.EnableBorder = value)' />
                @if (text.EnableBorder)
                {
                    <MacInspectorSlider Label="边框宽度" Value="@text.BorderWidth" Min="0" Max="20" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整文字边框", () => text.BorderWidth = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="内边距" Value="@text.BorderPadding" Min="0" Max="60" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整文字内边距", () => text.BorderPadding = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacInspectorSlider Label="圆角" Value="@text.BorderRadius" Min="0" Max="60" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整文字圆角", () => text.BorderRadius = (int)value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                    <MacColorInput Label="边框颜色" Value="@text.BorderColor" Disabled="@IsReadOnly" ValueChanged='value => Mutate("修改边框颜色", () => text.BorderColor = value)' />
                }
            </section>
            }
            @if (!IsV2 && Show(WMTemplateMobileInspectorSection.Spacing))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>外边距（相对容器）</h3></div>
                <MacInspectorSlider Label="上" Value="@text.Margin.Top" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => text.Margin.Top = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="右" Value="@text.Margin.Right" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => text.Margin.Right = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="下" Value="@text.Margin.Bottom" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => text.Margin.Bottom = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="左" Value="@text.Margin.Left" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => text.Margin.Left = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
            </section>
            }
        }
        else if (SelectedControl is WMLogo logo)
        {
            @if (Show(WMTemplateMobileInspectorSection.Logo)
                || Show(WMTemplateMobileInspectorSection.LogoSizing))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>@(Section == WMTemplateMobileInspectorSection.LogoSizing ? "缩放" : "图标")</h3></div>
                @if (Section is null)
                {
                    <div class="resource-field">
                        <div><span>图片</span><small>@ResourceName(logo.Path)</small></div>
                        <MButton Text Small Disabled="@IsReadOnly" OnClick="() => RequestAssetEditAsync(logo)">资源库</MButton>
                        <MButton Text Small Disabled="@(IsReadOnly || string.IsNullOrWhiteSpace(logo.Path))" OnClick='() => Mutate("清除图标", () => logo.Path = string.Empty)'>清除</MButton>
                    </div>
                }
                @if (Show(WMTemplateMobileInspectorSection.Logo))
                {
                    <div class="inspector-switch-grid" aria-label="图片操作">
                        <MacInspectorSwitch Label="允许作为可替换图片槽"
                                            Value="@(WMPosterAssetSlots.Find(Editor.Draft, logo) is not null)"
                                            Disabled="@IsReadOnly"
                                            ValueChanged="value => SetAssetSlotAsync(logo, value)" />
                        <MacInspectorSwitch Label="白色转透明" Value="@logo.White2Transparent" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换白色转透明", () => logo.White2Transparent = value)' />
                        <MacInspectorSwitch Label="自动识别品牌 Logo" Value="@logo.AutoSetLogo" Disabled="@IsReadOnly" ValueChanged='value => Mutate("切换自动识别品牌 Logo", () => logo.AutoSetLogo = value)' />
                    </div>
                }
                @if (IsV2 && Show(WMTemplateMobileInspectorSection.LogoSizing))
                {
                    <MacInspectorSwitch Label="角点调整保持图片比例"
                                        Value="@Editor.IsLogoAspectRatioLocked(logo.ID)"
                                        Disabled="@IsReadOnly"
                                        ValueChanged="value => Editor.SetLogoAspectRatioLocked(logo.ID, value)" />
                }
                @if (Show(WMTemplateMobileInspectorSection.LogoSizing))
                {
                    <MacInspectorSlider Label="尺寸" Value="@logo.Percent" Min="@(IsV2 ? 0.1 : 1)" Max="100" Step="@(IsV2 ? 0.1 : 1)" Unit="@(IsV2 ? "% 短边" : "% 容器短边")" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整图标尺寸", () => logo.Percent = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                }
            </section>
            }
            <MacNodeStyleInspector Editor="@Editor" Control="@logo" ReadOnly="@IsReadOnly" Section="@Section" />
            @if (IsV2 && logo.Style.Position == WMPosition.Absolute)
            {
                <MacTransformInspector Editor="@Editor" Control="@logo" Bounds="@SelectedBounds" ReadOnly="@IsReadOnly" Section="@Section" />
            }
            @if (!IsV2 && Show(WMTemplateMobileInspectorSection.Spacing))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>外边距（相对容器）</h3></div>
                <MacInspectorSlider Label="上" Value="@logo.Margin.Top" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => logo.Margin.Top = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="右" Value="@logo.Margin.Right" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => logo.Margin.Right = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="下" Value="@logo.Margin.Bottom" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => logo.Margin.Bottom = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="左" Value="@logo.Margin.Left" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => logo.Margin.Left = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
            </section>
            }
        }
        else if (SelectedControl is WMLine line)
        {
            @if (Show(WMTemplateMobileInspectorSection.Line))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>分割线</h3></div>
                <MacInspectorOptionGroup TValue="Orientation" Label="方向" Value="@line.Orientation" Options="@OrientationOptions"
                                         Disabled="@IsReadOnly" ValueChanged="value => SetLineOrientation(line, value)" />
                <MacInspectorSlider Label="粗细" Value="@line.Thickness" Min="1" Max="20" Step="1" Unit="像素" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整分割线粗细", () => SetLineThickness(line, (int)value))' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="长度" Value="@(IsV2 ? line.LengthPercent : line.Percent)" Min="1" Max="100" Step="1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整分割线长度", () => SetLineLength(line, value))' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacColorInput Label="颜色" Value="@line.Color" Disabled="@IsReadOnly" ValueChanged='value => Mutate("修改分割线颜色", () => line.Color = value)' />
            </section>
            }
            <MacNodeStyleInspector Editor="@Editor" Control="@line" ReadOnly="@IsReadOnly" Section="@Section" />
            @if (IsV2 && line.Style.Position == WMPosition.Absolute)
            {
                <MacTransformInspector Editor="@Editor" Control="@line" Bounds="@SelectedBounds" ReadOnly="@IsReadOnly" Section="@Section" />
            }
            @if (!IsV2 && Show(WMTemplateMobileInspectorSection.Spacing))
            {
            <section class="inspector-group">
                <div class="inspector-group-heading"><h3>外边距（相对容器）</h3></div>
                <MacInspectorSlider Label="上" Value="@line.Margin.Top" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => line.Margin.Top = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="右" Value="@line.Margin.Right" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => line.Margin.Right = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="下" Value="@line.Margin.Bottom" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => line.Margin.Bottom = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
                <MacInspectorSlider Label="左" Value="@line.Margin.Left" Min="-100" Max="100" Step="0.1" Unit="%" Disabled="@IsReadOnly" ValueChanged='value => SetSlider("调整外边距", () => line.Margin.Left = value)' InteractionStarted="BeginSliderAsync" InteractionEnded="EndSliderAsync" />
            </section>
            }
        }
    </div>

    @if (pendingDelete is not null)
    {
        <MDialog Persistent Value="true" ContentStyle="width:min(280px,calc(100vw - 32px));">
            <section class="inspector-confirm" role="dialog" aria-modal="true" aria-labelledby="inspector-delete-title">
                <h3 id="inspector-delete-title">删除“@ControlName(pendingDelete)”？</h3>
                <p>将同时删除 @pendingDescendantCount 个子图层，此操作可以撤销。</p>
                <div>
                    <MButton Text Small Class="secondary" OnClick="CancelDelete">取消</MButton>
                    <MButton Text Small Class="danger" OnClick="ConfirmDelete">删除</MButton>
                </div>
            </section>
        </MDialog>
    }

    @if (showExifEditor && SelectedControl is WMText exifText)
    {
        <MDialog Persistent
                 @bind-Value="showExifEditor"
                 ContentStyle="@(Global.IsMobile
                    ? "width:100vw;height:100vh;max-width:none;max-height:none;margin:0;"
                    : "width:min(980px,94vw);height:min(760px,92vh);")">
            <div class="exif-editor-shell" style="height:100%;min-height:0;overflow:hidden;position:relative;">
                <ExifConfig mText="@exifText"
                            CanvasType="@Editor.Draft.CanvasType"
                            ContainerId2Name="@ContainerNames"
                            OnClose="CompleteExifEditor"
                            OnCancel="CancelExifEditor" />
            </div>
        </MDialog>
    }
</aside>

@code {
    [Parameter, EditorRequired] public WMTemplateEditorState Editor { get; set; } = null!;
    [Parameter] public WMDesignRenderResult? RenderResult { get; set; }
    [Parameter] public WMDesignFunc DesignFunc { get; set; }
    [Parameter] public WMTemplateMobileInspectorSection? Section { get; set; }
    [Parameter] public EventCallback<WMText> TextContentEditRequested { get; set; }
    [Parameter] public EventCallback<IWMControl> AssetEditRequested { get; set; }

    private bool sliderInteractionActive;
    private static string TextStyleClass(bool active) => active
        ? "text-style-toggle is-active"
        : "text-style-toggle";
    private bool showExifEditor;
    private IWMControl pendingDelete;
    private int pendingDescendantCount;
    private List<string> fontNames = [];

    [Parameter] public EventCallback CloseRequested { get; set; }

    private IWMControl SelectedControl => string.IsNullOrWhiteSpace(Editor.SelectedControlId)
        ? null
        : WMControlTree.Find(Editor.Draft, Editor.SelectedControlId);
    private WMDesignBounds? SelectedBounds => string.IsNullOrWhiteSpace(Editor.SelectedControlId)
        ? null
        : RenderResult?.Bounds.FirstOrDefault(bounds => bounds.ControlId == Editor.SelectedControlId);
    private bool IsV2 => Editor.Draft.LayoutSchemaVersion >= WMLayoutMigration.CurrentSchemaVersion;
    private bool IsReadOnly => SelectedControl?.IsLocked == true;
    private bool Show(WMTemplateMobileInspectorSection section) => Section is null || Section == section;
    private string CanvasInsetHeading => Section switch
    {
        WMTemplateMobileInspectorSection.CanvasInsetTop => "上边距（相对画布）",
        WMTemplateMobileInspectorSection.CanvasInsetRight => "右边距（相对画布）",
        WMTemplateMobileInspectorSection.CanvasInsetBottom => "下边距（相对画布）",
        WMTemplateMobileInspectorSection.CanvasInsetLeft => "左边距（相对画布）",
        _ => "边距（相对画布）"
    };
    private string InspectorClass => Section is null
        ? "mac-selection-inspector"
        : "mac-selection-inspector mobile-inspector-section";
    private bool IsTopLevelContainer(WMContainer container) => Editor.Draft.Children.Any(root => ReferenceEquals(root, container));
    private string CurrentName => SelectedControl is null ? Editor.Draft.Name : ControlName(SelectedControl);
    private string CurrentTypeName => SelectedControl is null ? "画布" : TypeName(SelectedControl);
    private string Breadcrumb => SelectedControl is null
        ? "模板 / 画布"
        : $"模板 / {(WMControlTree.FindParent(Editor.Draft, SelectedControl.ID) is { } parent ? ControlName(parent) + " / " : string.Empty)}{ControlName(SelectedControl)}";
    private Dictionary<string, string> ContainerNames => Editor.Draft.RootContainers
        .SelectMany(root => new[] { root }.Concat(root.Controls.OfType<WMContainer>()))
        .GroupBy(container => container.ID)
        .ToDictionary(group => group.Key, group => ControlName(group.First()));
    private List<WmSelectOption<string>> FontOptions =>
        [new("默认字体", Global.DefaultFont), .. fontNames
            .Where(font => !string.Equals(font, Global.DefaultFont, StringComparison.Ordinal))
            .Select(font => new WmSelectOption<string>(font, font))];
    private List<WmSelectOption<string>> BoundContainerOptions =>
        [new("不关联", string.Empty), .. ContainerNames
            .OrderBy(item => item.Value, StringComparer.CurrentCulture)
            .Select(item => new WmSelectOption<string>(item.Value, item.Key))];

    protected override void OnInitialized() => ReloadFonts();

    private Task BeginSliderAsync()
    {
        if (sliderInteractionActive) return Task.CompletedTask;
        Editor.BeginTransaction(
            "调整属性",
            WMTemplateChangeKind.None,
            SelectedControl is null ? [] : [SelectedControl.ID]);
        sliderInteractionActive = true;
        return Task.CompletedTask;
    }

    private Task EndSliderAsync()
    {
        if (!sliderInteractionActive) return Task.CompletedTask;
        sliderInteractionActive = false;
        Editor.CommitTransaction();
        return Task.CompletedTask;
    }

    private void SetSlider(string label, Action mutation)
    {
        if (IsReadOnly) return;
        Editor.Mutate(label, mutation, ChangeKindFor(label), SelectedNodeIds());
    }

    private void Mutate(string label, Action mutation)
    {
        if (IsReadOnly && SelectedControl is not null) return;
        Editor.Mutate(label, mutation, ChangeKindFor(label), SelectedNodeIds());
    }

    private void RenameCurrent(ChangeEventArgs args)
    {
        var name = TextValue(args).Trim();
        if (string.IsNullOrWhiteSpace(name) || IsReadOnly) return;
        if (SelectedControl is { } control)
            Editor.Mutate("重命名图层", () => control.Name = name, WMTemplateChangeKind.Selection, [control.ID]);
        else
            Editor.Mutate("重命名模板", () => Editor.Draft.Name = name, WMTemplateChangeKind.Selection);
    }

    private void ToggleSelectedVisible()
    {
        if (SelectedControl is { } control)
            Editor.Mutate(
                "切换图层可见性",
                () => control.Enabled = !control.Enabled,
                WMTemplateChangeKind.Layout | WMTemplateChangeKind.Paint,
                [control.ID]);
    }

    private void ToggleSelectedLocked()
    {
        if (SelectedControl is { } control)
            Editor.Mutate("切换图层锁定", () => control.IsLocked = !control.IsLocked, WMTemplateChangeKind.Selection, [control.ID]);
    }

    private void DuplicateSelected()
    {
        if (SelectedControl is not { } control) return;
        IWMControl copy = null;
        Editor.Mutate("复制图层", () =>
        {
            copy = WMControlTree.Duplicate(Editor.Draft, control.ID);
            copy.Name = $"{ControlName(control)} 副本";
        }, WMTemplateChangeKind.Layout | WMTemplateChangeKind.Order | WMTemplateChangeKind.Paint, [control.ID]);
        if (copy is not null) Editor.Select(copy.ID);
    }

    private void RequestDeleteSelected()
    {
        if (SelectedControl is not { } control) return;
        var descendants = DescendantCount(control);
        if (control is WMContainer && descendants > 0)
        {
            pendingDelete = control;
            pendingDescendantCount = descendants;
            return;
        }
        DeleteSelected(control);
    }

    private void ConfirmDelete()
    {
        var control = pendingDelete;
        pendingDelete = null;
        pendingDescendantCount = 0;
        if (control is not null) DeleteSelected(control);
    }

    private void CancelDelete()
    {
        pendingDelete = null;
        pendingDescendantCount = 0;
    }

    private void DeleteSelected(IWMControl control)
    {
        var parentId = WMControlTree.FindParent(Editor.Draft, control.ID)?.ID;
        Editor.Mutate("删除图层", () =>
        {
            if (!WMControlTree.Remove(Editor.Draft, control.ID))
                throw new InvalidOperationException($"无法删除图层 {control.ID}。");
        }, WMTemplateChangeKind.Layout | WMTemplateChangeKind.Order | WMTemplateChangeKind.Paint, [control.ID]);
        Editor.Select(parentId);
    }

    private Task SetCanvasType(CanvasType value)
    {
        Editor.Mutate("修改画布类型", () => Editor.Draft.CanvasType = value, WMTemplateChangeKind.Canvas);
        return Task.CompletedTask;
    }

    private Task SetContainerOrientation(WMContainer container, Orientation value) =>
        MutateAsync("修改容器方向", () => container.Orientation = value);

    private Task SetHorizontalAlignment(WMContainer container, HorizontalAlignment value) =>
        MutateAsync("修改水平对齐", () => container.HorizontalAlignment = value);

    private Task SetVerticalAlignment(WMContainer container, VerticalAlignment value) =>
        MutateAsync("修改垂直对齐", () => container.VerticalAlignment = value);

    private Task SetLineOrientation(WMLine line, Orientation value) =>
        MutateAsync("修改分割线方向", () =>
        {
            if (IsV2)
                line.SetOrientationPreservingLength(value);
            else
                line.Orientation = value;
        });

    private void SetLineLength(WMLine line, double value)
    {
        if (IsV2)
            line.LengthPercent = value;
        else
            line.Percent = value;
    }

    private void SetLineThickness(WMLine line, int value)
    {
        if (IsV2)
            line.SetThicknessPreservingLength(value);
        else
            line.Thickness = value;
    }

    private Task SetFontFamily(WMText text, string value) =>
        MutateAsync("修改字体", () => text.FontFamily = value);

    private Task SetBoundContainer(WMText text, string value) =>
        MutateAsync("修改关联容器", () => text.BindedContainerId = value);

    private Task SetAssetSlotAsync(IWMControl control, bool value)
    {
        if (IsReadOnly) return Task.CompletedTask;
        Editor.Mutate(
            "切换可替换图片槽",
            () => WMPosterAssetSlots.SetReplaceable(Editor.Draft, control, value),
            WMTemplateChangeKind.Selection,
            [control.ID]);
        return Task.CompletedTask;
    }

    private Task MutateAsync(string label, Action mutation)
    {
        Mutate(label, mutation);
        return Task.CompletedTask;
    }

    private void SetCanvasWidth(ChangeEventArgs args) => Editor.Mutate("修改画布宽度", () => Editor.Draft.CustomWidth = IntValue(args, Editor.Draft.CustomWidth, 1), WMTemplateChangeKind.Canvas);
    private void SetCanvasHeight(ChangeEventArgs args) => Editor.Mutate("修改画布高度", () => Editor.Draft.CustomHeight = IntValue(args, Editor.Draft.CustomHeight, 1), WMTemplateChangeKind.Canvas);
    private void SetCanvasRatio(ChangeEventArgs args) => Editor.Mutate("修改画布比例", () => Editor.Draft.LengthWidthRatio = TextValue(args), WMTemplateChangeKind.Canvas);

    private async Task PickCanvasImageAsync()
    {
        if (DesignFunc?.SelectDefaultImageEvt is null) return;
        var path = await DesignFunc.SelectDefaultImageEvt();
        if (!string.IsNullOrWhiteSpace(path)) Editor.Mutate("选择默认图片", () => Editor.Draft.Path = path, WMTemplateChangeKind.Canvas | WMTemplateChangeKind.Resource);
    }

    private void ClearCanvasImage() => Editor.Mutate("清除默认图片", () => Editor.Draft.Path = string.Empty, WMTemplateChangeKind.Canvas | WMTemplateChangeKind.Resource);

    private async Task RequestAssetEditAsync(IWMControl control)
    {
        if (AssetEditRequested.HasDelegate)
        {
            await AssetEditRequested.InvokeAsync(control);
            return;
        }

        if (control is WMContainer container)
            await RunPickerTransactionAsync(
                "选择容器图片",
                () => DesignFunc?.SelectContainer?.Invoke(container) ?? Task.CompletedTask);
        else if (control is WMLogo logo)
            await RunPickerTransactionAsync(
                "选择图标",
                () => DesignFunc?.SelectLogo?.Invoke(logo) ?? Task.CompletedTask);
    }

    private async Task RunPickerTransactionAsync(string label, Func<Task> picker)
    {
        if (IsReadOnly) return;
        Editor.BeginTransaction(
            label,
            WMTemplateChangeKind.Resource | WMTemplateChangeKind.Layout | WMTemplateChangeKind.Paint,
            SelectedNodeIds());
        try
        {
            await picker();
            Editor.CommitTransaction();
        }
        catch
        {
            Editor.CancelTransaction();
            throw;
        }
    }

    private async Task ImportFontAsync()
    {
        if (DesignFunc?.ImportFontEvt is null || IsReadOnly) return;
        await DesignFunc.ImportFontEvt();
        ReloadFonts();
    }

    private void ReloadFonts() => fontNames = Global.ReadFont().Keys.OrderBy(name => name).ToList();

    private void OpenExifEditor(WMText text)
    {
        if (IsReadOnly || showExifEditor) return;
        Editor.BeginTransaction(
            "配置拍摄信息",
            WMTemplateChangeKind.Resource | WMTemplateChangeKind.Layout | WMTemplateChangeKind.Paint,
            [text.ID]);
        showExifEditor = true;
    }

    private async Task RequestTextContentEditAsync(WMText text)
    {
        if (TextContentEditRequested.HasDelegate)
        {
            await TextContentEditRequested.InvokeAsync(text);
            return;
        }

        OpenExifEditor(text);
    }

    private void CompleteExifEditor(WMText text)
    {
        showExifEditor = false;
        Editor.CommitTransaction();
    }

    private void CancelExifEditor()
    {
        showExifEditor = false;
        Editor.CancelTransaction();
    }

    private string[] SelectedNodeIds() =>
        SelectedControl is null ? [] : [SelectedControl.ID];

    private WMTemplateChangeKind ChangeKindFor(string label)
        => WMTemplatePropertyChangeClassifier.Classify(
            SelectedControl is null,
            label);

    private static string TextValue(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;
    private static int IntValue(ChangeEventArgs args, int fallback, int minimum = int.MinValue) => int.TryParse(TextValue(args), out var value) ? Math.Max(value, minimum) : fallback;
    private static string ResourceName(string path) => string.IsNullOrWhiteSpace(path) ? "未选择" : Path.GetFileName(path);
    private static string TextContentSummary(WMText text)
    {
        var value = WMTextContentPreview.Resolve(text.Exifs);
        if (string.IsNullOrWhiteSpace(value)) return "尚未添加文字";
        value = value.Replace("\r", " ").Replace("\n", " ");
        return value.Length > 42 ? $"{value[..42]}…" : value;
    }
    private static string ControlName(IWMControl control) => string.IsNullOrWhiteSpace(control.Name) ? TypeName(control) : control.Name;
    private static string TypeName(IWMControl control) => control switch { WMContainer => "容器", WMText => "文字", WMLogo => "图标", WMLine => "分割线", _ => "图层" };
    private static readonly List<MacInspectorOption<CanvasType>> CanvasTypeOptions =
    [
        new(CanvasType.Normal, "普通", "image"),
        new(CanvasType.Split, "拼图", "grid-nine")
    ];

    private static readonly List<MacInspectorOption<Orientation>> OrientationOptions =
    [
        new(Orientation.Horizontal, "横向", "rows"),
        new(Orientation.Vertical, "纵向", "columns")
    ];

    private static readonly List<MacInspectorOption<HorizontalAlignment>> HorizontalAlignmentOptions =
    [
        new(HorizontalAlignment.Left, "左", "align-left"),
        new(HorizontalAlignment.Center, "居中", "align-center-horizontal"),
        new(HorizontalAlignment.Right, "右", "align-right")
    ];

    private static readonly List<MacInspectorOption<VerticalAlignment>> VerticalAlignmentOptions =
    [
        new(VerticalAlignment.Top, "顶部", "align-top"),
        new(VerticalAlignment.Center, "居中", "align-center-vertical"),
        new(VerticalAlignment.Bottom, "底部", "align-bottom")
    ];

    private static int DescendantCount(IWMControl control)
    {
        if (control is not WMContainer container) return 0;
        var visited = new HashSet<IWMControl>(ReferenceEqualityComparer.Instance);
        var stack = new Stack<IWMControl>(container.Controls);
        while (stack.TryPop(out var current))
        {
            if (!visited.Add(current)) continue;
            if (current is WMContainer nested)
                foreach (var child in nested.Controls) stack.Push(child);
        }
        return visited.Count;
    }

    public void Dispose()
    {
        if (sliderInteractionActive) Editor.CancelTransaction();
        if (showExifEditor) Editor.CancelTransaction();
    }
