@using Masa.Blazor
@using Watermark.Razor.Parts
@using Watermark.Shared.Models
@if (fStyle != null)
{
    <div style="justify-content:space-between;display:flex;align-items:center;height:30px;">
        <div style="display:flex;align-items:center">
            <Label Name="样式设置" />
            <MSwitch Color="primary" @bind-Value="fStyle.Enabled" Class="ml-2" Flat Inset/>
        </div>

        @if (fStyle.Enabled)
        {
            <div>
                <ToggleButton @bind-Open="@fStyle.IsItalic" On="@ICONS.Italic" Off="@ICONS.Italic" />
                <ToggleButton @bind-Open="@fStyle.IsBold" On="@ICONS.Bold" Off="@ICONS.Bold" />
            </div>
            
        }
    </div>

    @if (fStyle.Enabled)
    {
        <div style="display:flex;justify-content:space-between;align-items:center">
            @* <WmTextField @bind-Value="fStyle.FontSize" Label="字体大小" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-5" Style="width:80px" /> *@
            <ColorPicker Name="颜色" @bind-Color="fStyle.FontColor" Class="mr-1 my-1"/>
            <WmSelect TValue="string"
                      @bind-Value="fStyle.FontFamily"
                      Options="@FontOptions"
                      Label="字体"
                      AriaLabel="字体"
                      Style="width:50%;" />
        </div>

    }
}



@code {
    Dictionary<string, string> Fonts = new Dictionary<string, string>();
    protected override async Task OnInitializedAsync()
    {
        Fonts = await Task.Run(() => Global.ReadFont());
    }
    private IReadOnlyList<WmSelectOption<string>> FontOptions
    {
        get
        {
            var values = Fonts.Keys
                .OrderBy(font => font, StringComparer.OrdinalIgnoreCase)
                .Select(font => new WmSelectOption<string>(font, font))
                .ToList();
            if (!string.IsNullOrWhiteSpace(fStyle?.FontFamily)
                && values.All(option => !string.Equals(option.Value, fStyle.FontFamily, StringComparison.Ordinal)))
            {
                values.Insert(0, new WmSelectOption<string>(fStyle.FontFamily, fStyle.FontFamily));
            }
            return values;
        }
    }
    [Parameter]
    public WMFontStyle fStyle { get; set; }
}
