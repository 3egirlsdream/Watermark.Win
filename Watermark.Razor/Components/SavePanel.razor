@using Watermark.Shared.Models

<WmCard Elevation="0">
    <div class="d-flex justify-end pa-2">
        <WmButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="primary" Class="ml-auto" OnClick="Export">保存</WmButton>
    </div>
    <WmCardContent>
        <WmForm>
            <WmSelect TValue="string" @bind-Value="Global.Resolution" Options="@ResolutionOptions" Label="分辨率" AriaLabel="导出分辨率" />
            <WmSelect TValue="int" @bind-Value="Global.Quality" Options="@QualityOptions" Label="图片质量" AriaLabel="图片质量" />
            @* <WmTextField Label="输出目录" Value="@("Pictures/DaVinciFrameMaster")" Variant="Variant.Text" ReadOnly="true" Margin="Margin.Dense" /> *@
        </WmForm>
    </WmCardContent>
</WmCard>

            
@code {
    private static readonly IReadOnlyList<WmSelectOption<string>> ResolutionOptions =
    [new("原图", "default"), new("1080P", "1080"), new("4K", "2160")];
    private static readonly IReadOnlyList<WmSelectOption<int>> QualityOptions =
    [new("原图", 100), new("高", 85), new("中", 70)];

    [Parameter]
    public EventCallback ExportEvent { get; set; }

    void Export() 
    {
        if (ExportEvent.HasDelegate) ExportEvent.InvokeAsync();
    }
}
