@using Watermark.Razor.Components.Mac
@using Watermark.Razor.Workspace
@namespace Watermark.Razor.Components.Compatibility
@inject IWMHapticFeedback HapticFeedback

@* Public numeric input for every mobile parameter adjustment. *@
<MacInspectorSlider Label="@Label"
                     Value="@Value"
                     Min="@Min"
                     Max="@Max"
                     Step="@Step"
                     Unit="@Unit"
                     Disabled="@Disabled"
                     ShowLabel="@ShowLabel"
                     CssClass="@CssClass"
                     ValueChanged="HandleValueChangedAsync"
                     InteractionStarted="@InteractionStarted"
                     InteractionEnded="@InteractionEnded" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback InteractionStarted { get; set; }
    [Parameter] public EventCallback InteractionEnded { get; set; }

    private bool hasReportedValue;
    private double lastReportedValue;

    protected override void OnParametersSet()
    {
        // Keep externally-applied changes silent, while retaining the latest value
        // emitted during a drag before the parent has completed its re-render.
        if (!hasReportedValue || !Value.Equals(lastReportedValue))
        {
            lastReportedValue = Value;
            hasReportedValue = true;
        }
    }

    private async Task HandleValueChangedAsync(double value)
    {
        if (Disabled) return;

        var valueChanged = !hasReportedValue || !value.Equals(lastReportedValue);
        lastReportedValue = value;
        hasReportedValue = true;

        await ValueChanged.InvokeAsync(value);

        // IWMHapticFeedback is a platform-safe adapter: mobile hosts provide a
        // light click, while desktop and unsupported environments safely no-op.
        if (valueChanged)
            HapticFeedback.Perform();
    }
}
