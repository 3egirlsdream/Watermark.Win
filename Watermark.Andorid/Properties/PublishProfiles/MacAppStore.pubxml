<Project>
  <PropertyGroup>
    <MacDistributionChannel>AppStore</MacDistributionChannel>
    <SelfContained>true</SelfContained>
    <EnableCodeSigning>true</EnableCodeSigning>
    <EnablePackageSigning>true</EnablePackageSigning>
    <CreatePackage>true</CreatePackage>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- Imported assets can carry quarantine metadata even when the code signature is valid. -->
  <Target Name="RemoveMacAppStoreQuarantine" BeforeTargets="_CodesignAppBundle"
          Condition="'$(TargetFramework)' == 'net8.0-maccatalyst' And Exists('$(AppBundleDir)')">
    <Message Text="Removing quarantine metadata before signing $(AppBundleDir)" Importance="high" />
    <Exec Command="/usr/bin/xattr -dr com.apple.quarantine &quot;$(AppBundleDir)&quot;" />
  </Target>
</Project>
